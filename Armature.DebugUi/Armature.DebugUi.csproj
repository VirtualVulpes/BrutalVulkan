<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Armature.DebugUi</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.2"/>
        <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Armature.Core\Armature.Core.csproj" />
        <ProjectReference Include="..\Armature.Input\Armature.Input.csproj" />
        <ProjectReference Include="..\Armature.Rendering\Armature.Rendering.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="shaders\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="shaders\debug_ui"/>
    </ItemGroup>

</Project>
