<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4"/>
        <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5"/>
        <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui.Abstractions" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.Ktx" Version="2026.10.2"/>
        <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.Stb" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.3"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="models\"/>
        <Folder Include="textures\"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="shaders\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\vertex\flat_color.vert">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\vertex\imgui.vert">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\vertex\normal.vert">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\vertex\world_space.vert">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\flat_color.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\imgui.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\line.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\flat_texture.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\normal.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\phong_texture.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="shaders\fragment\phong_color.frag">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Armature.Core\Armature.Core.csproj" />
        <ProjectReference Include="..\Armature.DebugUi\Armature.DebugUi.csproj" />
        <ProjectReference Include="..\Armature.Input\Armature.Input.csproj" />
        <ProjectReference Include="..\Armature.Scene\Armature.Scene.csproj" />
        <ProjectReference Include="..\Armature.SceneRendering\Armature.SceneRendering.csproj" />
        <ProjectReference Include="..\Armature.Editor\Armature.Editor.csproj" />
    </ItemGroup>
</Project>
